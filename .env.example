# Copy this file to .env and edit it. Never commit .env.

# AI model for prompt editing. Pick one by your computer's RAM:
#   8 GB RAM   -> qwen2.5:3b    (about 2 GB download, recommended)
#   16 GB RAM  -> qwen2.5:7b    (about 5 GB download)
#   32 GB+ RAM -> qwen2.5:14b   (about 9 GB download)
OLLAMA_MODEL=qwen2.5:3b

# Speech-to-text model: base (fast, recommended for 8 GB) or small (better, needs more time)
WHISPER_MODEL=base

# Optional: use Google Gemini (free tier) instead of the local model
AI_PROVIDER=ollama
GEMINI_API_KEY=

# Optional: paid Higgsfield clip generator
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
